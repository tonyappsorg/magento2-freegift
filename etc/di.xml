<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\SalesRule\Model\Rule\Action\Discount\CalculatorFactory">
        <arguments>
            <argument name="discountRules" xsi:type="array">
                <item name="tonyapps_free_gift" xsi:type="string">Tonyapps\FreeGift\Model\Rule\Action\Discount\FreeGift</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\SalesRule\Model\Rule\Action\SimpleActionOptionsProvider">
        <plugin name="tonyapps_freegift_action_option" type="Tonyapps\FreeGift\Plugin\AddFreeGiftAction"/>
    </type>
    <type name="Magento\SalesRule\Model\Utility">
        <plugin name="tonyapps_freegift_hide_gifts_from_conditions" type="Tonyapps\FreeGift\Plugin\SalesRule\HideGiftsFromRuleConditions"/>
    </type>
</config>

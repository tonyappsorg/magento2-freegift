<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="actions">
        <field name="tonyapps_gift_skus" formElement="input" sortOrder="15">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">sales_rule</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Free Gift SKUs</label>
                <notice translate="true">Only used when Apply is "Add free gift". Comma-separated simple product SKUs; each one is added once at zero price. Set Discount Amount to 0.</notice>
                <dataScope>tonyapps_gift_skus</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
